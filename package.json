{
  "name": "christ-in-song-worship-app",
  "version": "1.0.0",
  "description": "Christ in Song Worship App — offline hymn library, worship builder, and full-screen presenter for Sabbath services.",
  "author": {
    "name": "VaChinoda Worship"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "homepage": "./app",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron . --dev",
    "build": "electron-builder --dir",
    "desktop": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:win": "electron-builder --win --publish=never",
    "dist:linux": "electron-builder --linux --publish=never",
    "dist:all": "electron-builder --mac --win --linux --publish=never",
    "release": "electron-builder --publish=always"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.1.7",
    "electron-updater": "^6.3.4"
  },
  "build": {
    "appId": "com.christinsong.worshipapp",
    "productName": "Christ in Song Worship App",
    "copyright": "Copyright © 2026 VaChinoda Worship",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "app/**/*",
      "build/**/*",
      "scripts/**/*",
      "package.json",
      "README.md",
      "BUILD_GUIDE.md",
      "CODE_SIGNING.md",
      "ARCHITECTURE.txt",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterSign": "scripts/notarize.js",
    "dmg": {
      "background": null,
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "publisherName": "Christ in Song Worship App"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Christ in Song Worship App"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Audio",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] }
      ],
      "desktop": {
        "Name": "Christ in Song Worship App",
        "Comment": "300-hymn worship OS with presenter mode",
        "Categories": "AudioVideo;Audio;Music;"
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.christinsong.app/releases/"
      }
    ]
  }
}
