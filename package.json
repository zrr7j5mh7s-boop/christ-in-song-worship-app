{
  "name": "christ-in-song-worship-app",
  "version": "1.0.0",
  "description": "VaChinoda Worship App — offline hymn library, worship builder, and full-screen presenter for Sabbath services.",
  "author": {
    "name": "VaChinoda Worship",
    "email": "juliuschinoda@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/zrr7j5mh7s-boop/christ-in-song-worship-app#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrr7j5mh7s-boop/christ-in-song-worship-app.git"
  },
  "bugs": {
    "url": "https://github.com/zrr7j5mh7s-boop/christ-in-song-worship-app/issues"
  },
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron . --dev",
    "build": "electron-builder --dir",
    "desktop": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "verify:release": "node scripts/verify-release.js",
    "test:obs-settings": "node scripts/test-obs-settings.js",
    "test:obs-integration": "node scripts/test-obs-integration.js",
    "test:obs": "npm run test:obs-settings && npm run test:obs-integration && npm run test:obs-program-monitor",
    "test:obs-program-monitor": "node scripts/test-obs-program-monitor.js",
    "test:camera-sources": "node scripts/test-camera-sources.js",
    "test:hymn-index": "node scripts/test-hymn-index.js",
    "test:hymnal-library": "node scripts/test-hymnal-library.js",
    "test:hymnal-integration": "node scripts/test-hymnal-integration.js",
    "test:bible-projection": "node scripts/test-bible-projection.js",
    "test:live-hymn-queue": "node scripts/test-live-hymn-queue.js",
    "test:service-mode": "node scripts/test-service-mode.js",
    "test:live-switch": "node scripts/test-live-switch.js",
    "test:branding": "node scripts/test-branding.js",
    "test:help": "node scripts/test-help-centre.js",
    "test:performance": "node scripts/test-performance.js",
    "test:performance-audit": "node scripts/test-performance-audit.js",
    "test:ux-consistency": "node scripts/test-ux-consistency.js",
    "test:quiet-service-mode": "node scripts/test-quiet-service-mode.js",
    "test:keyboard-shortcuts": "node scripts/test-keyboard-shortcuts.js",
    "test:worship-search": "node scripts/test-worship-search.js",
    "test:stage-display": "node scripts/test-stage-display.js",
    "test:session-recovery": "node scripts/test-session-recovery.js",
    "test:projection-rendering": "node scripts/test-projection-rendering.js",
    "benchmark:performance": "node scripts/benchmark-performance.js",
    "build:web-assets": "node scripts/build-production-assets.js",
    "pack": "electron-builder --dir",
    "dist": "npm run build:web-assets && npm run verify:release && electron-builder --publish=never",
    "dist:mac": "npm run build:web-assets && npm run verify:release && electron-builder --mac --publish=never",
    "dist:mac:unsigned": "npm run build:web-assets && npm run verify:release && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish=never",
    "dist:win": "npm run build:web-assets && npm run verify:release && electron-builder --win --publish=never",
    "dist:linux": "npm run build:web-assets && npm run verify:release && electron-builder --linux --publish=never",
    "dist:all": "npm run build:web-assets && npm run verify:release && electron-builder --mac --win --linux --publish=never",
    "release": "npm run build:web-assets && npm run verify:release && electron-builder --publish=always",
    "release:mac": "npm run build:web-assets && npm run verify:release && electron-builder --mac --publish=always",
    "release:win": "npm run build:web-assets && npm run verify:release && electron-builder --win --publish=always",
    "release:linux": "npm run build:web-assets && npm run verify:release && electron-builder --linux --publish=always"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "electron-log": "^5.1.7",
    "electron-updater": "^6.3.4",
    "obs-websocket-js": "^5.0.8"
  },
  "build": {
    "appId": "com.vachinoda.christinsong",
    "productName": "VaChinoda Worship App",
    "copyright": "Copyright © 2026 VaChinoda Worship",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "app/**/*",
      "build/icon.icns",
      "build/icon.ico",
      "build/icon.png",
      "build/icon.svg",
      "build/entitlements.mac.plist",
      "scripts/**/*",
      "package.json",
      "README.md",
      "BUILD_GUIDE.md",
      "CODE_SIGNING.md",
      "ARCHITECTURE.txt",
      "!build/icon.iconset/**",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterSign": "scripts/notarize.js",
    "dmg": {
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "VaChinoda Worship"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VaChinoda Worship App"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Audio",
      "maintainer": "VaChinoda Worship <juliuschinoda@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "Name": "VaChinoda Worship App",
        "Comment": "300-hymn worship OS with presenter mode",
        "Categories": "AudioVideo;Audio;Music;"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zrr7j5mh7s-boop",
        "repo": "christ-in-song-worship-app",
        "releaseType": "release"
      }
    ]
  }
}
