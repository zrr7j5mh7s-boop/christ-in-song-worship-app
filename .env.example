# VaChinoda controlled pilot licensing
# Copy to .env for local development. Never commit real production secrets.

# --- Electron app (verification public key only) ---
# PEM contents or path via src/license/license-public-key.pem at build time
PILOT_LICENSE_PUBLIC_KEY=

# Supabase Edge Functions base URL (preferred for production pilots)
PILOT_LICENSE_API_BASE=https://YOUR_PROJECT.supabase.co/functions/v1

# Alternative: derive API base from project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# --- Development only (blocked when app.isPackaged) ---
PILOT_LICENSE_MOCK_SERVER=true
PILOT_LICENSE_MOCK_BASE=http://127.0.0.1:47824
PILOT_LICENSE_MOCK_PORT=47824
PILOT_MOCK_ACTIVATION_CODE=PILOT-DEV-0001
PILOT_MOCK_EMAIL=pilot@example.org

# --- Supabase Edge Functions secrets (server-side only; never package in the app) ---
PILOT_LICENSE_SIGNING_PRIVATE_KEY=
PILOT_ADMIN_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
